SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
AI_API_KEY=
AI_MODEL=

# Frontend origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate limits ("<number>/<sec|min|hour|day>"). Defaults shown; set only to change them.
# THROTTLE_ANALYZE_BURST=5/min
# THROTTLE_ANALYZE_DAILY=50/day
# THROTTLE_ANALYZE_GLOBAL=500/day
# THROTTLE_EXTRACT=20/min

# Proxies in front of the app, used to find the real client IP for rate limits.
# Leave unset locally; set NUM_PROXIES=1 on Render.
# NUM_PROXIES=1
